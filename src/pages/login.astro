---
// src/pages/login.astro
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Login - EverythingTogther</title>
  </head>
  <body class="bg-[#e6e9e3] min-h-screen flex items-center justify-center font-sans">
    
    <div class="bg-white border-4 border-black p-8 w-full max-w-md shadow-[8px_8px_0_0_#000]">
      <h1 class="text-3xl font-black uppercase mb-6 border-b-4 border-black pb-2">Join the Club</h1>
      
      <form id="auth-form" class="space-y-6">
        <div>
          <label class="block font-bold mb-2 uppercase text-sm">Email</label>
          <input type="email" id="email" class="w-full border-4 border-black p-3 focus:outline-none focus:bg-yellow-100 transition-colors shadow-[4px_4px_0_0_#000]" required>
        </div>
        
        <div>
          <label class="block font-bold mb-2 uppercase text-sm">Password</label>
          <input type="password" id="password" class="w-full border-4 border-black p-3 focus:outline-none focus:bg-yellow-100 transition-colors shadow-[4px_4px_0_0_#000]" required>
        </div>
<div class="flex justify-end mt-1">
  <a href="/forgot-password" class="text-xs text-indigo-400 hover:underline">
    Forgot password?
  </a>
</div>
        <div id="error-message" class="text-red-600 font-bold hidden border-2 border-red-600 bg-red-100 p-2 text-sm uppercase"></div>

        <div class="flex gap-4 pt-2">
          <button type="submit" id="login-btn" class="flex-1 bg-yellow-400 border-4 border-black font-black uppercase py-3 shadow-[4px_4px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all">
            Log In
          </button>
          <button type="button" id="signup-btn" class="flex-1 bg-cyan-400 border-4 border-black font-black uppercase py-3 shadow-[4px_4px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all">
            Sign Up
          </button>
        </div>
      </form>
    </div>

    <script>
      import { supabase } from '../lib/supabase';

      const emailInput = document.getElementById('email') as HTMLInputElement;
      const passwordInput = document.getElementById('password') as HTMLInputElement;
      const loginBtn = document.getElementById('login-btn');
      const signupBtn = document.getElementById('signup-btn');
      const errorMsg = document.getElementById('error-message');

      function showError(msg: string) {
        if (errorMsg) {
          errorMsg.textContent = msg;
          errorMsg.classList.remove('hidden');
        }
      }

      // 1. Handle Sign Up
      signupBtn?.addEventListener('click', async () => {
        const { error } = await supabase.auth.signUp({
          email: emailInput.value,
          password: passwordInput.value,
        });
        
        if (error) showError(error.message);
        else alert('Success! Check your email to verify your account.');
      });

      // 2. Handle Log In
      loginBtn?.addEventListener('click', async (e) => {
        e.preventDefault(); // Prevent page reload
        const { error } = await supabase.auth.signInWithPassword({
          email: emailInput.value,
          password: passwordInput.value,
        });
        
        if (error) showError(error.message);
        else {
          alert('Logged in successfully!');
          window.location.href = '/dashboard'; 
        }
      });
    </script>
  </body>
</html>