---
import { supabase } from '../lib/supabase';

let message = '';
let error = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const email = formData.get('email')?.toString();

  if (email) {
    const origin = new URL(Astro.request.url).origin;
    const { error: resetError } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${origin}/reset-password`,
    });

    if (resetError) {
      error = resetError.message;
    } else {
      message = 'Check your email for the password reset link!';
    }
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot Password | EverythingTogether</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-white flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-xl">
      <h1 class="text-2xl font-bold mb-2">Reset Your Password</h1>
      <p class="text-slate-400 text-sm mb-6">
        Enter your email address and we'll send you a link to reset your password.
      </p>

      {message && (
        <div class="mb-4 p-3 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-sm">
          {message}
        </div>
      )}

      {error && (
        <div class="mb-4 p-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-sm">
          {error}
        </div>
      )}

      <form method="POST" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1">Email Address</label>
          <input
            type="email"
            name="email"
            required
            placeholder="you@example.com"
            class="w-full px-4 py-2.5 rounded-lg bg-slate-800 border border-slate-700 text-white focus:outline-none focus:border-indigo-500"
          />
        </div>
        <button
          type="submit"
          class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 font-semibold rounded-lg transition"
        >
          Send Reset Link
        </button>
      </form>

      <div class="mt-6 text-center">
        <a href="/login" class="text-sm text-indigo-400 hover:underline">← Back to Login</a>
      </div>
    </div>
  </body>
</html>