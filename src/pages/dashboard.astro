---
// src/pages/dashboard.astro
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard | EverythingTogether</title>
  </head>
  <body class="bg-slate-50 min-h-screen p-4 sm:p-8 font-sans text-slate-900">
    
    <div class="max-w-3xl mx-auto space-y-8">
      
      <!-- Header -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center bg-white p-6 rounded-2xl shadow-sm border border-slate-200 gap-4">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Dashboard</h1>
        <div class="flex gap-3">
          <a id="view-page-btn" href="#" target="_blank" class="hidden px-4 py-2 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 font-medium rounded-lg transition-colors">
            View Live Page ↗
          </a>
          <button id="logout-btn" class="px-4 py-2 bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 font-medium rounded-lg transition-colors">
            Log Out
          </button>
        </div>
      </div>
      
      <!-- 1. Profile & Theme Builder -->
      <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200">
        <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
          <span class="bg-indigo-100 text-indigo-700 w-8 h-8 rounded-full flex items-center justify-center text-sm">1</span> 
          Profile & Design
        </h2>
        
        <form id="profile-form" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Username</label>
              <input type="text" id="username" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all bg-slate-50 focus:bg-white" required>
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Display Name</label>
              <input type="text" id="display-name" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all bg-slate-50 focus:bg-white" required>
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Avatar Image URL (Optional)</label>
            <input type="url" id="avatar-url" placeholder="https://..." class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all bg-slate-50 focus:bg-white">
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Short Bio</label>
            <textarea id="bio" rows="2" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all bg-slate-50 focus:bg-white"></textarea>
          </div>

          <!-- Advanced Design Customizer -->
          <div class="p-5 bg-slate-50 border border-slate-200 rounded-xl space-y-6">
            <h3 class="font-semibold text-slate-800">Design Your Page</h3>
            
            <!-- Colors -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-medium text-slate-500 uppercase tracking-wider">Background</label>
                <input type="color" id="custom-bg" value="#f8fafc" class="w-full h-10 rounded-lg cursor-pointer border-0 bg-transparent p-0">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-medium text-slate-500 uppercase tracking-wider">Text</label>
                <input type="color" id="custom-text" value="#0f172a" class="w-full h-10 rounded-lg cursor-pointer border-0 bg-transparent p-0">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-medium text-slate-500 uppercase tracking-wider">Button BG</label>
                <input type="color" id="custom-btn" value="#3b82f6" class="w-full h-10 rounded-lg cursor-pointer border-0 bg-transparent p-0">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-medium text-slate-500 uppercase tracking-wider">Button Text</label>
                <input type="color" id="custom-btn-text" value="#ffffff" class="w-full h-10 rounded-lg cursor-pointer border-0 bg-transparent p-0">
              </div>
            </div>

            <!-- Shapes & Fonts -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 border-t border-slate-200 pt-5">
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-medium text-slate-500 uppercase tracking-wider">Font Style</label>
                <select id="font-family" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
                  <option value="font-sans">Modern (Sans)</option>
                  <option value="font-serif">Elegant (Serif)</option>
                  <option value="font-mono">Retro (Mono)</option>
                </select>
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-medium text-slate-500 uppercase tracking-wider">Button Shape</label>
                <select id="button-shape" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
                  <option value="rounded-2xl">Rounded Corners</option>
                  <option value="rounded-full">Pill Shape</option>
                  <option value="rounded-none">Sharp Square</option>
                </select>
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-medium text-slate-500 uppercase tracking-wider">Button Style</label>
                <select id="button-style" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
                  <option value="fill">Solid Fill</option>
                  <option value="outline">Outline Only</option>
                  <option value="brutalist">Hard Shadow (Brutalist)</option>
                </select>
              </div>
            </div>
          </div>

          <button type="submit" id="save-profile-btn" class="w-full sm:w-auto px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl transition-colors shadow-sm">
            Save Profile & Design
          </button>
        </form>
      </div>

      <!-- 2. Add Links -->
      <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
          <h2 class="text-xl font-bold flex items-center gap-2">
            <span class="bg-indigo-100 text-indigo-700 w-8 h-8 rounded-full flex items-center justify-center text-sm">2</span> 
            Add Links
          </h2>
          <button type="button" id="add-row-btn" class="px-4 py-2 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 font-medium rounded-lg text-sm transition-colors flex items-center gap-1">
            <span>+</span> Add Row
          </button>
        </div>

        <form id="add-link-form" class="space-y-4">
          <div id="link-rows-container" class="space-y-4">
            <div class="link-row bg-slate-50 border border-slate-200 rounded-xl p-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Link Title</label>
                <input type="text" name="title" placeholder="My YouTube" class="link-title w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none bg-white" required>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">URL</label>
                <input type="url" name="url" placeholder="https://..." class="link-url w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none bg-white" required>
              </div>
            </div>
          </div>
          <button type="submit" id="submit-link-btn" class="w-full sm:w-auto px-8 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl transition-colors shadow-sm">
            Save Links
          </button>
        </form>
      </div>

      <!-- 3. Manage Links -->
      <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200">
        <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
          <span class="bg-indigo-100 text-indigo-700 w-8 h-8 rounded-full flex items-center justify-center text-sm">3</span> 
          Manage Links
        </h2>
        <div id="links-container" class="space-y-3">
          <p class="text-slate-500 animate-pulse">Loading your links...</p>
        </div>
      </div>
    </div>

    <script>
      import { supabase } from '../lib/supabase';
      let currentUserId = '';

      async function checkUser() {
        const { data: { user } } = await supabase.auth.getUser();
        if (!user) {
          window.location.href = '/login';
          return;
        }
        currentUserId = user.id; 
        loadProfile();
        loadLinks();
      }
      checkUser();

      // Add extra link row
      document.getElementById('add-row-btn')?.addEventListener('click', () => {
        const container = document.getElementById('link-rows-container');
        const row = document.createElement('div');
        row.className = 'link-row bg-slate-50 border border-slate-200 rounded-xl p-4 relative';
        row.innerHTML = `
          <button type="button" class="remove-row-btn absolute -top-2 -right-2 bg-red-100 hover:bg-red-200 text-red-600 w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold transition-colors">✕</button>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Link Title</label>
              <input type="text" name="title" placeholder="Another Link" class="link-title w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none bg-white" required>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">URL</label>
              <input type="url" name="url" placeholder="https://..." class="link-url w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none bg-white" required>
            </div>
          </div>
        `;
        row.querySelector('.remove-row-btn')?.addEventListener('click', () => row.remove());
        container?.appendChild(row);
      });

      // Load Profile & Theme Data
      async function loadProfile() {
        try {
          const res = await fetch('/api/get-profile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: currentUserId })
          });
          if (!res.ok) return;
          const profile = await res.json();
          if (profile && profile.username) {
            (document.getElementById('username') as HTMLInputElement).value = profile.username;
            (document.getElementById('display-name') as HTMLInputElement).value = profile.displayName || '';
            (document.getElementById('bio') as HTMLTextAreaElement).value = profile.bio || '';
            (document.getElementById('avatar-url') as HTMLInputElement).value = profile.avatarUrl || '';
            
            (document.getElementById('custom-bg') as HTMLInputElement).value = profile.customBg || '#f8fafc';
            (document.getElementById('custom-text') as HTMLInputElement).value = profile.customText || '#0f172a';
            (document.getElementById('custom-btn') as HTMLInputElement).value = profile.customButton || '#3b82f6';
            (document.getElementById('custom-btn-text') as HTMLInputElement).value = profile.customButtonText || '#ffffff';
            
            (document.getElementById('font-family') as HTMLSelectElement).value = profile.fontFamily || 'font-sans';
            (document.getElementById('button-shape') as HTMLSelectElement).value = profile.buttonShape || 'rounded-2xl';
            (document.getElementById('button-style') as HTMLSelectElement).value = profile.buttonStyle || 'fill';
            
            const viewBtn = document.getElementById('view-page-btn') as HTMLAnchorElement;
            viewBtn.href = `/${profile.username}`;
            viewBtn.classList.remove('hidden');
          }
        } catch (err) {
          console.error('Error loading profile:', err);
        }
      }

      // Load Links
      async function loadLinks() {
        const container = document.getElementById('links-container');
        try {
          const res = await fetch('/api/get-links', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: currentUserId })
          });
          const links = await res.json();
          
          if (!Array.isArray(links) || links.length === 0) {
            container!.innerHTML = '<p class="text-slate-500 p-4 bg-slate-50 rounded-xl border border-slate-200">No links added yet.</p>';
            return;
          }

          container!.innerHTML = links.map((link: any) => `
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-slate-50 border border-slate-200 p-4 rounded-xl">
              <div class="overflow-hidden">
                <p class="font-bold text-slate-800">${link.title}</p>
                <a href="${link.url}" target="_blank" class="text-sm text-indigo-600 hover:underline break-all">${link.url}</a>
              </div>
              <div class="flex gap-2 shrink-0">
                <button onclick="editLink(${link.id}, '${link.title.replace(/'/g, "\\'")}', '${link.url.replace(/'/g, "\\'")}')" class="px-3 py-1.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg transition-colors">
                  Edit
                </button>
                <button onclick="deleteLink(${link.id})" class="px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 text-sm font-medium rounded-lg transition-colors">
                  Delete
                </button>
              </div>
            </div>
          `).join('');
        } catch (err) {
          console.error('Error loading links:', err);
        }
      }

      // Edit & Delete Link Functions
      (window as any).editLink = async (linkId: number, oldTitle: string, oldUrl: string) => {
        const title = prompt('Update Link Title:', oldTitle);
        if (!title) return;
        const url = prompt('Update Link URL:', oldUrl);
        if (!url) return;
        await fetch('/api/update-link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId: currentUserId, linkId, title, url })
        });
        loadLinks();
      };

      (window as any).deleteLink = async (linkId: number) => {
        if (!confirm('Are you sure you want to delete this link?')) return;
        await fetch('/api/delete-link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId: currentUserId, linkId })
        });
        loadLinks();
      };

      // Handle Profile & Design Save
      document.getElementById('profile-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const saveBtn = document.getElementById('save-profile-btn') as HTMLButtonElement;
        saveBtn.textContent = 'Saving...';
        saveBtn.disabled = true;

        const body = {
          id: currentUserId,
          username: (document.getElementById('username') as HTMLInputElement).value,
          displayName: (document.getElementById('display-name') as HTMLInputElement).value,
          bio: (document.getElementById('bio') as HTMLTextAreaElement).value,
          avatarUrl: (document.getElementById('avatar-url') as HTMLInputElement).value,
          customBg: (document.getElementById('custom-bg') as HTMLInputElement).value,
          customText: (document.getElementById('custom-text') as HTMLInputElement).value,
          customButton: (document.getElementById('custom-btn') as HTMLInputElement).value,
          customButtonText: (document.getElementById('custom-btn-text') as HTMLInputElement).value,
          fontFamily: (document.getElementById('font-family') as HTMLSelectElement).value,
          buttonShape: (document.getElementById('button-shape') as HTMLSelectElement).value,
          buttonStyle: (document.getElementById('button-style') as HTMLSelectElement).value,
        };
        
        const res = await fetch('/api/save-profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });

        saveBtn.textContent = 'Save Profile & Design';
        saveBtn.disabled = false;

        if (res.ok) {
          alert('Profile & Design Saved!');
          loadProfile();
        } else {
          const errData = await res.json().catch(() => ({}));
          alert('Error saving profile: ' + (errData.error || 'Unknown error'));
        }
      });

      // Handle Add Links Submit
      document.getElementById('add-link-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const rows = document.querySelectorAll('.link-row');
        const submitBtn = document.getElementById('submit-link-btn') as HTMLButtonElement;
        submitBtn.textContent = 'Saving...';
        submitBtn.disabled = true;

        for (const row of rows) {
          await fetch('/api/add-link', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              userId: currentUserId, 
              title: (row.querySelector('.link-title') as HTMLInputElement).value, 
              url: (row.querySelector('.link-url') as HTMLInputElement).value 
            })
          });
        }
        submitBtn.textContent = 'Save Links';
        submitBtn.disabled = false;

        document.getElementById('link-rows-container')!.innerHTML = `
          <div class="link-row bg-slate-50 border border-slate-200 rounded-xl p-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Link Title</label>
              <input type="text" name="title" placeholder="My YouTube" class="link-title w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none bg-white" required>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">URL</label>
              <input type="url" name="url" placeholder="https://..." class="link-url w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none bg-white" required>
            </div>
          </div>`;
        loadLinks();
      });

      // Handle Logout
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await supabase.auth.signOut();
        window.location.href = '/login';
      });
    </script>
  </body>
</html>