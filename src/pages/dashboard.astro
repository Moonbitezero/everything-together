---
// src/pages/dashboard.astro
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Dashboard - EverythingTogether</title>
  </head>
  <body class="bg-[#e6e9e3] min-h-screen p-8 font-sans">
    
    <div class="max-w-3xl mx-auto bg-white border-4 border-black p-8 shadow-[8px_8px_0_0_#000]">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b-4 border-black pb-4 mb-6 gap-4">
        <h1 class="text-4xl font-black uppercase">Dashboard</h1>
        <div class="flex gap-3">
          <a id="view-page-btn" href="#" target="_blank" class="hidden bg-lime-400 border-4 border-black font-black uppercase px-4 py-2 shadow-[4px_4px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all">
            View My Page ↗
          </a>
          <button id="logout-btn" class="bg-red-400 border-4 border-black font-black uppercase px-4 py-2 shadow-[4px_4px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all">
            Log Out
          </button>
        </div>
      </div>
      
     <!-- 1. Profile & Theme Setup Form -->
      <div class="bg-yellow-200 border-4 border-black p-6 shadow-[4px_4px_0_0_#000] mb-8">
        <h2 class="text-2xl font-bold uppercase mb-4">1. Customize Profile</h2>
        <form id="profile-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-bold mb-1 uppercase text-sm">Username (No spaces)</label>
              <input type="text" id="username" class="w-full border-4 border-black p-2 focus:outline-none focus:bg-white shadow-[4px_4px_0_0_#000]" required>
            </div>
            <div>
              <label class="block font-bold mb-1 uppercase text-sm">Display Name</label>
              <input type="text" id="display-name" class="w-full border-4 border-black p-2 focus:outline-none focus:bg-white shadow-[4px_4px_0_0_#000]" required>
            </div>
          </div>

          <div>
            <label class="block font-bold mb-1 uppercase text-sm">Avatar Image URL (Optional)</label>
            <input type="url" id="avatar-url" placeholder="https://api.dicebear.com/7.x/bottts/svg?seed=sameer" class="w-full border-4 border-black p-2 focus:outline-none focus:bg-white shadow-[4px_4px_0_0_#000]">
          </div>

          <div>
            <label class="block font-bold mb-1 uppercase text-sm">Short Bio</label>
            <textarea id="bio" rows="2" placeholder="Creator, editor & developer..." class="w-full border-4 border-black p-2 focus:outline-none focus:bg-white shadow-[4px_4px_0_0_#000]"></textarea>
          </div>

          <div>
            <label class="block font-bold mb-1 uppercase text-sm">Page Style & Theme</label>
            <select id="theme-bg" class="w-full border-4 border-black p-2 font-bold bg-white shadow-[4px_4px_0_0_#000] focus:outline-none">
              <optgroup label="✨ Modern & Clean (Most Popular)">
                <option value="minimal-light">Minimal Light (Clean Apple/Notion Vibe)</option>
                <option value="dark-glass">Midnight Glass (Sleek Dark Mode)</option>
                <option value="sunset-gradient">Sunset Gradient (Soft & Modern)</option>
                <option value="pastel-sage">Soft Sage (Calm & Rounded)</option>
              </optgroup>
              <optgroup label="⚡ Neo-Brutalist (Bold Borders)">
                <option value="#e6e9e3">Brutalist Concrete Grey</option>
                <option value="#fef08a">Brutalist Cyber Yellow</option>
                <option value="#a5f3fc">Brutalist Electric Cyan</option>
                <option value="#fbcfe8">Brutalist Pink</option>
                <option value="#bbf7d0">Brutalist Acid Green</option>
              </optgroup>
            </select>
          </div>
          <button type="submit" id="save-profile-btn" class="bg-white border-4 border-black font-black uppercase px-6 py-3 shadow-[4px_4px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all mt-4">
            Save Profile
          </button>
        </form>
      </div>

      <!-- 2. Add Multiple Links Form -->
      <div class="border-4 border-black p-6 bg-cyan-200 shadow-[4px_4px_0_0_#000] mb-8">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 gap-2">
          <h2 class="text-2xl font-bold uppercase">2. Add Links</h2>
          <button type="button" id="add-row-btn" class="bg-lime-400 border-4 border-black font-black uppercase px-4 py-1.5 text-sm shadow-[4px_4px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all">
            + Add Another Link Row
          </button>
        </div>

        <form id="add-link-form" class="space-y-4">
          <div id="link-rows-container" class="space-y-4">
            <!-- First Link Row -->
            <div class="link-row bg-white border-4 border-black p-4 shadow-[4px_4px_0_0_#000] grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-bold mb-1 uppercase text-xs">Link Title (e.g., My YouTube)</label>
                <input type="text" name="title" placeholder="YouTube Channel" class="link-title w-full border-4 border-black p-2 focus:outline-none focus:bg-yellow-100" required>
              </div>
              <div>
                <label class="block font-bold mb-1 uppercase text-xs">URL (e.g., https://youtube.com/...)</label>
                <input type="url" name="url" placeholder="https://youtube.com/..." class="link-url w-full border-4 border-black p-2 focus:outline-none focus:bg-yellow-100" required>
              </div>
            </div>
          </div>

          <button type="submit" id="submit-link-btn" class="bg-yellow-400 border-4 border-black font-black uppercase px-6 py-3 shadow-[4px_4px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all mt-4">
            Save All Links
          </button>
        </form>
      </div>

      <!-- 3. Manage Links -->
      <div class="border-4 border-black p-6 bg-white shadow-[4px_4px_0_0_#000] mb-8">
        <h2 class="text-2xl font-bold uppercase mb-4">3. Manage Your Links</h2>
        <div id="links-container" class="space-y-4">
          <p class="font-medium text-gray-600">Loading your links...</p>
        </div>
      </div>
    </div>

    <script>
      import { supabase } from '../lib/supabase';

      let currentUserId = '';

      // 1. Verify User, Load Profile & Load Links
      async function checkUser() {
        const { data: { user } } = await supabase.auth.getUser();
        if (!user) {
          window.location.href = '/login';
          return;
        }
        currentUserId = user.id; 
        loadProfile();
        loadLinks();
      }
      checkUser();

      // Add Another Link Input Row Dynamically
      document.getElementById('add-row-btn')?.addEventListener('click', () => {
        const container = document.getElementById('link-rows-container');
        const row = document.createElement('div');
        row.className = 'link-row bg-white border-4 border-black p-4 shadow-[4px_4px_0_0_#000] relative';
        row.innerHTML = `
          <button type="button" class="remove-row-btn absolute -top-3 -right-3 bg-red-400 border-4 border-black font-black px-2 py-0.5 text-xs shadow-[2px_2px_0_0_#000]">✕</button>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-bold mb-1 uppercase text-xs">Link Title</label>
              <input type="text" name="title" placeholder="Instagram / GitHub / Portfolio" class="link-title w-full border-4 border-black p-2 focus:outline-none focus:bg-yellow-100" required>
            </div>
            <div>
              <label class="block font-bold mb-1 uppercase text-xs">URL</label>
              <input type="url" name="url" placeholder="https://..." class="link-url w-full border-4 border-black p-2 focus:outline-none focus:bg-yellow-100" required>
            </div>
          </div>
        `;
        row.querySelector('.remove-row-btn')?.addEventListener('click', () => row.remove());
        container?.appendChild(row);
      });

      // Load Existing Profile Data
      async function loadProfile() {
        const res = await fetch('/api/get-profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId: currentUserId })
        });
        if (!res.ok) return;
        const profile = await res.json();
        if (profile && profile.username) {
          (document.getElementById('username') as HTMLInputElement).value = profile.username;
          (document.getElementById('display-name') as HTMLInputElement).value = profile.displayName || '';
          (document.getElementById('bio') as HTMLTextAreaElement).value = profile.bio || '';
          (document.getElementById('avatar-url') as HTMLInputElement).value = profile.avatarUrl || '';
          (document.getElementById('theme-bg') as HTMLSelectElement).value = profile.themeBackground || '#e6e9e3';
          
          const viewBtn = document.getElementById('view-page-btn') as HTMLAnchorElement;
          viewBtn.href = `/${profile.username}`;
          viewBtn.classList.remove('hidden');
        }
      }

      // 2. Fetch and Display Links
      async function loadLinks() {
        const container = document.getElementById('links-container');
        try {
          const res = await fetch('/api/get-links', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: currentUserId })
          });
          
          if (!res.ok) throw new Error('Failed to fetch');
          const links = await res.json();
          
          if (links.length === 0) {
            container!.innerHTML = '<p class="font-bold border-2 border-black p-2 bg-gray-100">No links added yet.</p>';
            return;
          }

          container!.innerHTML = links.map((link: any) => `
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-cyan-100 border-4 border-black p-4 shadow-[4px_4px_0_0_#000]">
              <div class="overflow-hidden">
                <p class="font-black uppercase text-lg">${link.title}</p>
                <a href="${link.url}" target="_blank" class="text-sm underline font-medium hover:text-blue-600 break-all">${link.url}</a>
              </div>
              <div class="flex gap-2 shrink-0">
                <button onclick="editLink(${link.id}, '${link.title.replace(/'/g, "\\'")}', '${link.url.replace(/'/g, "\\'")}')" class="bg-yellow-300 border-4 border-black font-black uppercase px-4 py-2 hover:translate-x-1 hover:translate-y-1 transition-all">
                  Edit
                </button>
                <button onclick="deleteLink(${link.id})" class="bg-red-400 border-4 border-black font-black uppercase px-4 py-2 hover:translate-x-1 hover:translate-y-1 transition-all">
                  Delete
                </button>
              </div>
            </div>
          `).join('');
        } catch (err) {
          container!.innerHTML = '<p class="font-bold border-2 border-red-600 p-2 bg-red-100 text-red-600">Make sure get-links.ts is created in src/pages/api/</p>';
        }
      }

      // 3. Edit & Delete Link Functions
      (window as any).editLink = async (linkId: number, oldTitle: string, oldUrl: string) => {
        const title = prompt('Update Link Title:', oldTitle);
        if (!title) return;
        const url = prompt('Update Link URL:', oldUrl);
        if (!url) return;

        await fetch('/api/update-link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId: currentUserId, linkId, title, url })
        });
        loadLinks();
      };

      (window as any).deleteLink = async (linkId: number) => {
        if (!confirm('Are you sure you want to delete this link?')) return;
        
        await fetch('/api/delete-link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId: currentUserId, linkId })
        });
        
        loadLinks();
      };

      // 4. Handle Profile Save/Update
      document.getElementById('profile-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const username = (document.getElementById('username') as HTMLInputElement).value;
        const displayName = (document.getElementById('display-name') as HTMLInputElement).value;
        const bio = (document.getElementById('bio') as HTMLTextAreaElement).value;
        const avatarUrl = (document.getElementById('avatar-url') as HTMLInputElement).value;
        const themeBackground = (document.getElementById('theme-bg') as HTMLSelectElement).value;
        
        const res = await fetch('/api/save-profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: currentUserId, username, displayName, bio, avatarUrl, themeBackground })
        });

        if (res.ok) {
          alert('Profile updated!');
          loadProfile();
        } else {
          alert('Error saving profile. Username might be taken.');
        }
      });

      // 5. Handle Saving Multiple Links at Once
      document.getElementById('add-link-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const rows = document.querySelectorAll('.link-row');
        const submitBtn = document.getElementById('submit-link-btn') as HTMLButtonElement;
        submitBtn.textContent = 'Saving...';
        submitBtn.disabled = true;

        let allOk = true;
        for (const row of rows) {
          const title = (row.querySelector('.link-title') as HTMLInputElement).value;
          const url = (row.querySelector('.link-url') as HTMLInputElement).value;

          const res = await fetch('/api/add-link', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: currentUserId, title, url })
          });
          if (!res.ok) allOk = false;
        }

        submitBtn.textContent = 'Save All Links';
        submitBtn.disabled = false;

        if (allOk) {
          // Reset back to a single clean input row
          const container = document.getElementById('link-rows-container')!;
          container.innerHTML = `
            <div class="link-row bg-white border-4 border-black p-4 shadow-[4px_4px_0_0_#000] grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-bold mb-1 uppercase text-xs">Link Title (e.g., My YouTube)</label>
                <input type="text" name="title" placeholder="YouTube Channel" class="link-title w-full border-4 border-black p-2 focus:outline-none focus:bg-yellow-100" required>
              </div>
              <div>
                <label class="block font-bold mb-1 uppercase text-xs">URL (e.g., https://youtube.com/...)</label>
                <input type="url" name="url" placeholder="https://youtube.com/..." class="link-url w-full border-4 border-black p-2 focus:outline-none focus:bg-yellow-100" required>
              </div>
            </div>
          `;
          loadLinks();
        } else {
          alert('Error saving links. Did you save your profile first?');
        }
      });

      // 6. Handle Log Out
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await supabase.auth.signOut();
        window.location.href = '/login';
      });
    </script>
  </body>
</html>