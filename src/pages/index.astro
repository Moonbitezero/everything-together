---
// src/pages/index.astro
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary SEO Meta Tags -->
    <title>EverythingTogether - One Link for All Your Content</title>
    <meta name="title" content="EverythingTogether - One Link for All Your Content" />
    <meta name="description" content="Create your custom Neobrutalist Link-in-Bio page in seconds. One central link for all your social profiles, videos, and portfolio." />
    
    <!-- Open Graph / Social Media Sharing (WhatsApp, Facebook, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://everythingtogether.in/" />
    <meta property="og:title" content="EverythingTogether - One Link for All Your Content" />
    <meta property="og:description" content="Create your custom Neobrutalist Link-in-Bio page in seconds." />
    
    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content="EverythingTogether" />
    <meta property="twitter:description" content="One link for all your content." />
  </head>
  <body class="bg-[#e6e9e3] min-h-screen flex flex-col items-center justify-center p-8 font-sans">
    
    <div class="max-w-2xl text-center flex flex-col items-center">
      <div class="bg-white border-4 border-black p-8 shadow-[8px_8px_0_0_#000] mb-8 w-full">
        <h1 class="text-5xl sm:text-6xl font-black uppercase mb-4 tracking-tight">Everything<br/>Together</h1>
        <p class="text-xl font-bold border-t-4 border-black pt-4 mt-4 bg-yellow-200 inline-block px-4 py-2 border-4">
          One link for all your content.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 w-full justify-center">
        <a href="/login" class="bg-cyan-400 border-4 border-black font-black uppercase text-xl px-8 py-4 shadow-[6px_6px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all text-center">
          Claim Your Link
        </a>
        <a href="/login" class="bg-white border-4 border-black font-black uppercase text-xl px-8 py-4 shadow-[6px_6px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all text-center">
          Log In
        </a>
      </div>
    </div>

  </body>
</html>