---
// src/pages/[username].astro
import { db } from '../db';
import { profiles, links } from '../db/schema';
import { eq } from 'drizzle-orm';

const { username } = Astro.params;

if (!username) {
  return Astro.redirect('/404');
}

const userProfile = await db
  .select()
  .from(profiles)
  .where(eq(profiles.username, username))
  .limit(1);

if (!userProfile.length) {
  return new Response('User not found', { status: 404 });
}

const profile = userProfile[0];
const userLinks = await db
  .select()
  .from(links)
  .where(eq(links.userId, profile.id));

const theme = profile.themeBackground || 'minimal-light';
const isBrutalist = theme.startsWith('#');

// Dynamic style presets
const themeStyles: Record<string, {
  body: string;
  card: string;
  avatar: string;
  title: string;
  bio: string;
  link: string;
}> = {
  'minimal-light': {
    body: 'bg-slate-50 text-slate-900',
    card: 'bg-white border border-slate-200 rounded-3xl p-8 shadow-sm',
    avatar: 'w-24 h-24 rounded-full object-cover border border-slate-200 shadow-sm',
    title: 'text-2xl font-bold tracking-tight text-slate-900',
    bio: 'text-slate-500 text-sm mt-2',
    link: 'block w-full bg-slate-900 hover:bg-slate-800 text-white font-medium py-3.5 px-6 rounded-2xl text-center transition-all duration-200 shadow-sm hover:shadow-md hover:-translate-y-0.5'
  },
  'dark-glass': {
    body: 'bg-slate-950 text-white bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-950 via-slate-950 to-black',
    card: 'bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-8 shadow-2xl',
    avatar: 'w-24 h-24 rounded-full object-cover ring-2 ring-indigo-500/50',
    title: 'text-2xl font-bold tracking-tight text-white',
    bio: 'text-slate-400 text-sm mt-2',
    link: 'block w-full bg-white/10 hover:bg-white/15 border border-white/10 text-white font-medium py-3.5 px-6 rounded-2xl text-center transition-all duration-200 hover:-translate-y-0.5'
  },
  'sunset-gradient': {
    body: 'bg-gradient-to-br from-rose-100 via-amber-50 to-orange-100 text-slate-900',
    card: 'bg-white/80 backdrop-blur-md border border-white rounded-3xl p-8 shadow-xl',
    avatar: 'w-24 h-24 rounded-full object-cover ring-4 ring-white shadow-md',
    title: 'text-2xl font-bold text-slate-900',
    bio: 'text-slate-600 text-sm mt-2',
    link: 'block w-full bg-white hover:bg-rose-50 border border-rose-200/60 text-slate-800 font-semibold py-3.5 px-6 rounded-2xl text-center shadow-sm transition-all duration-200 hover:-translate-y-0.5'
  },
  'pastel-sage': {
    body: 'bg-[#f1f5f2] text-emerald-950',
    card: 'bg-white border border-emerald-100 rounded-3xl p-8 shadow-sm',
    avatar: 'w-24 h-24 rounded-full object-cover border-2 border-emerald-200',
    title: 'text-2xl font-semibold text-emerald-950',
    bio: 'text-emerald-700/80 text-sm mt-2',
    link: 'block w-full bg-emerald-900 hover:bg-emerald-800 text-white font-medium py-3.5 px-6 rounded-full text-center transition-all duration-200 hover:-translate-y-0.5'
  }
};

const currentStyle = isBrutalist
  ? {
      body: 'text-black',
      card: 'bg-white border-4 border-black p-8 shadow-[8px_8px_0_0_#000]',
      avatar: 'w-24 h-24 rounded-full object-cover border-4 border-black shadow-[4px_4px_0_0_#000]',
      title: 'text-3xl font-black uppercase tracking-tight',
      bio: 'font-bold text-gray-700 mt-2',
      link: 'block w-full bg-yellow-300 hover:bg-lime-400 border-4 border-black font-black uppercase py-3.5 px-6 text-center shadow-[4px_4px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all'
    }
  : themeStyles[theme] || themeStyles['minimal-light'];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.displayName || profile.username} | EverythingTogether</title>
  </head>
  <body
    class={`min-h-screen flex items-center justify-center p-6 font-sans ${currentStyle.body}`}
    style={isBrutalist ? `background-color: ${theme};` : ''}
  >
    <div class={`w-full max-w-md ${currentStyle.card}`}>
      <div class="flex flex-col items-center text-center mb-8">
        <img
          src={profile.avatarUrl || `https://api.dicebear.com/7.x/shapes/svg?seed=${profile.username}`}
          alt={profile.displayName}
          class={`mb-4 ${currentStyle.avatar}`}
        />
        <h1 class={currentStyle.title}>{profile.displayName || profile.username}</h1>
        <p class="text-xs opacity-60 mt-0.5">@{profile.username}</p>
        {profile.bio && <p class={currentStyle.bio}>{profile.bio}</p>}
      </div>

      <div class="space-y-3.5">
        {userLinks.length === 0 ? (
          <p class="text-center text-sm opacity-60 py-4">No links added yet.</p>
        ) : (
          userLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class={currentStyle.link}>
              {link.title}
            </a>
          ))
        )}
      </div>
    </div>
  </body>
</html>