---
// src/pages/[username].astro
import { db } from '../db';
import { users, links } from '../db/schema';
import { eq } from 'drizzle-orm';

const { username } = Astro.params;

if (!username) {
  return Astro.redirect('/404');
}

const userProfile = await db
  .select()
  .from(users)
  .where(eq(users.username, username.toLowerCase()))
  .limit(1);

if (!userProfile.length) {
  return new Response('User not found', { status: 404 });
}

const profile = userProfile[0];
const userLinks = await db
  .select()
  .from(links)
  .where(eq(links.userId, profile.id));

// Use the custom colors from the database, or fall back to defaults
const bg = profile.customBg || '#f8fafc';
const textColor = profile.customText || '#0f172a';
const btnBg = profile.customButton || '#3b82f6';
const btnText = profile.customButtonText || '#ffffff';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.displayName || profile.username} | EverythingTogether</title>
  </head>
  <body
    class="min-h-screen flex flex-col items-center py-16 px-6 font-sans transition-colors duration-300"
    style={`background-color: ${bg}; color: ${textColor};`}
  >
    <div class="w-full max-w-xl">
      <!-- Profile Header -->
      <div class="flex flex-col items-center text-center mb-10">
        <img
          src={profile.avatarUrl || `https://api.dicebear.com/7.x/shapes/svg?seed=${profile.username}`}
          alt={profile.displayName}
          class="w-28 h-28 rounded-full object-cover mb-4 shadow-lg border-2 border-white/20"
        />
        <h1 class="text-3xl font-bold tracking-tight mb-1">{profile.displayName || profile.username}</h1>
        <p class="text-sm opacity-75 font-medium mb-3">@{profile.username}</p>
        
        {profile.bio && (
          <p class="text-base opacity-90 max-w-md leading-relaxed">{profile.bio}</p>
        )}
      </div>

      <!-- Links List -->
      <div class="space-y-4">
        {userLinks.length === 0 ? (
          <p class="text-center text-sm opacity-60 py-8 bg-black/5 rounded-2xl">No links added yet.</p>
        ) : (
          userLinks.map((link) => (
            <a 
              href={link.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="block w-full py-4 px-6 rounded-2xl text-center font-semibold text-lg transition-all duration-200 hover:scale-[1.02] hover:shadow-xl shadow-md"
              style={`background-color: ${btnBg}; color: ${btnText};`}
            >
              {link.title}
            </a>
          ))
        )}
      </div>
      
      <!-- Footer branding -->
      <div class="mt-16 text-center">
        <a href="/" class="text-xs font-bold uppercase tracking-widest opacity-40 hover:opacity-100 transition-opacity">
          ⚡ Built with EverythingTogether
        </a>
      </div>
    </div>
  </body>
</html>