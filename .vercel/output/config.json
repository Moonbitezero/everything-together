{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/add-link/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/delete-link/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/get-links/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/get-profile/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/save-profile/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/track-click/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/sitemap\\.xml$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render"
		}
	]
}